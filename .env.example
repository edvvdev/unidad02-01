# Configuracion local del corpus aprovado en LAB04.
# Copie este archivo como .env (no se versiona) y ajuste solo lo necesario.
# En este proyecto los valores ya corresponden al corpus elegido, de modo que
# un clon limpio reproduce el experimento sin editar nada.

# Fuente de los datos: "url" (descarga verificable) o "local" (archivo ya descargado)
DATA_SOURCE=url

# Ruta del CSV normalizado que usan la auditoria, el entrenamiento y las pruebas
DATASET_PATH=data/raw/dataset.csv

# Enlace original de descarga (ficha publica, no un archivo reenviado)
DATASET_URL=https://archive.ics.uci.edu/static/public/331/sentiment+labelled+sentences.zip

# Nombres reales de las columnas del corpus
TEXT_COLUMN=sentence
TARGET_COLUMN=score

# Semilla reproducible para particion y muestreo
RANDOM_STATE=42

# Identificacion y verificacion del corpus
DATASET_NAME=Sentiment Labelled Sentences (UCI 331)
DATASET_PAGE=https://archive.ics.uci.edu/dataset/331/sentiment-labelled-sentences
DATASET_LICENSE=CC BY 4.0
DATASET_SHA256=afc26626d710899948693e1a61405dce197f57ffa719fa1130d346b4cc095343
